{
  "script": "mmb_size_thresholds_from_controls.py",
  "paths": {
    "input_dir": "D:\\ICL MBE\\Year 4\\FYP\\Software Automation\\Pre Term Birth\\Raw Flow Data\\MMB & DG Controls Unrefined",
    "output_json": "D:\\ICL MBE\\Year 4\\FYP\\Software Automation\\Pre Term Birth\\Visual Flow Data\\Json Files\\mmb_fsc_thresholds.json"
  },
  "transform": {
    "name": "logicle",
    "source": "flowutils.transforms.logicle",
    "params_rule": {
      "T": "max(262144, observed vmax)",
      "M": 4.5,
      "W": 0.5,
      "A": "0.5 if vmin < 0 else 0.0"
    }
  },
  "fsc_channel": "FSC-H",
  "shoulder_fraction_strategy": {
    "boundary_3_6": {
      "source_population": "6MMB",
      "drop_frac": 0.05,
      "definition": "median 5% left shoulder of 6MMB controls"
    },
    "boundary_6_8": {
      "source_population": "8MMB",
      "drop_frac": 0.2,
      "definition": "median 20% left shoulder of 8MMB controls"
    },
    "rationale": "The 6MMB and 8MMB FSC-H distributions are close together. After empirical optimisation, a 20% left shoulder for 8MMB was selected. This shifts boundary_6_8 closer to the 8MMB peak, reducing the likelihood that high-FSC 6MMB events are misclassified as 8MMB."
  },
  "min_events_per_file": 500,
